# Server-only database connection. Use a pooled Neon connection string.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Prefer a restricted Stripe key with Checkout Session read/write permission.
STRIPE_SECRET_KEY=rk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Public base URL, without a trailing slash.
APP_URL=http://localhost:3000

# Cloudflare Turnstile. The public key is intentionally browser-visible.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Vercel injects this for cron requests in production.
CRON_SECRET=

# Optional: explicit origin allowed to call checkout. Defaults to APP_URL.
ALLOWED_ORIGIN=http://localhost:3000

# Integration tests only; never point this at production.
TEST_DATABASE_URL=
